{
  "id": "rsi_macd",
  "name": "RSI + MACD 골든크로스 전략",
  "enabled": false,
  "schedule": {
    "entry_time": "10:30",
    "monitor_interval_sec": 30
  },
  "universe": {
    "market": "0",
    "top_volume": 100,
    "min_price": 1000,
    "max_price": 200000
  },
  "entry": {
    "min_change_rate": -10.0,
    "max_change_rate": 10.0,
    "indicators": {
      "rsi":  {"period": 14, "oversold": 35},
      "macd": {"fast": 12, "slow": 26, "signal": 9}
    },
    "sort_by": "execution_strength",
    "max_stocks": 3,
    "amount_per_stock": 1000000,
    "order_type": "market"
  },
  "exit": {
    "take_profit": 2.0,
    "stop_loss": -2.0
  }
}
